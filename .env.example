# ==============================================================================
# InfoSphere Router & SOC Intrusion Monitor Configuration
# ==============================================================================
# NOTE: All options are optional and BLANK by default.
# If left blank, InfoSphere uses 100% passive in-process Win32 ARP hardware
# discovery, which detects connected devices without requiring router login.
#
# If you wish to enable active router management API inspection:
# 1. Copy this file to .env (e.g. `copy .env.example .env`)
# 2. Fill in your router gateway IP and administrator credentials below.
# ==============================================================================

# Router Gateway IP address (e.g. 192.168.0.1, 192.168.1.1, or leave blank)
INFOSPHERE_ROUTER_IP=

# Router Administrative Portal Username (leave blank if not using router web portal)
INFOSPHERE_ROUTER_USERNAME=

# Router Administrative Portal Password (leave blank if not using router web portal)
INFOSPHERE_ROUTER_PASSWORD=

# Optional: Weather location override (leave blank to auto-detect from local IP)
INFOSPHERE_WEATHER_CITY=
